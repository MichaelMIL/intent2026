	(text "VSYS = 4.65 V on USB (after D6), 3.0-4.8 V on battery. With both present VBUS holds Q1 off, D6 blocks back-feed."
		(exclude_from_sim no)
		(at 160.02 102.87 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "482b7aa6-2c1f-500a-b450-09906eac0e85")
	)
	(text "SW5 is DNP (the switch is on the battery box); JP1 bridges it. Cut JP1 only if SW5 is fitted."
		(exclude_from_sim no)
		(at 160.02 106.68 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "aaf7f2b2-a9d4-58ac-9717-dec715528709")
	)
	(text "RGB LEDs run from VSYS, everything else from 3V3 (AP2112K-3.3, 600 mA, EN tied to VIN)."
		(exclude_from_sim no)
		(at 160.02 110.49 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "751bffad-b2dd-5858-adcb-46559c5bfe04")
	)
	(text "R15/R16: VBUS_SENSE = 2.5 V on USB, 0 V on battery (GPIO29 / ADC3) so firmware can dim and sleep."
		(exclude_from_sim no)
		(at 160.02 114.3 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "688194f7-26a4-5d86-84d9-175dd3f36e11")
	)
